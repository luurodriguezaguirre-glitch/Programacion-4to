
import tkinter as tk
from tkinter import messagebox
import random

FILAS = 9
COLUMNAS = 9
MINAS = 10

class Buscaminas:
    def __init__(self, ventana):
        self.ventana = ventana
        self.ventana.title("Buscaminas")
        self.ventana.resizable(False, False)
        self.ventana.configure(bg="#263238")

        self.colores = {
            1: "#1976D2",
            2: "#388E3C",
            3: "#D32F2F",
            4: "#7B1FA2",
            5: "#795548",
            6: "#0097A7",
            7: "#212121",
            8: "#616161"
        }

        self.marco_superior = tk.Frame(
            ventana, bg="#263238", pady=12
        )
        self.marco_superior.pack()

        self.etiqueta_minas = tk.Label(
            self.marco_superior,
            font=("Arial", 14, "bold"),
            fg="white",
            bg="#263238"
        )
        self.etiqueta_minas.grid(row=0, column=0, padx=15)

        self.boton_reiniciar = tk.Button(
            self.marco_superior,
            text="😊 Reiniciar",
            font=("Arial", 12),
            command=self.reiniciar
        )
        self.boton_reiniciar.grid(row=0, column=1, padx=10)

        self.etiqueta_tiempo = tk.Label(
            self.marco_superior,
            font=("Arial", 14, "bold"),
            fg="white",
            bg="#263238"
        )
        self.etiqueta_tiempo.grid(row=0, column=2, padx=15)

        self.marco_tablero = tk.Frame(
            ventana, bg="#455A64", padx=8, pady=8
        )
        self.marco_tablero.pack(padx=12, pady=(0, 12))

        self.botones = []

        for fila in range(FILAS):
            fila_botones = []

            for columna in range(COLUMNAS):
                boton = tk.Button(
                    self.marco_tablero,
                    width=3,
                    height=1,
                    font=("Arial", 15, "bold"),
                    bg="#B0BEC5",
                    relief="raised"
                )

                boton.grid(row=fila, column=columna)

                boton.bind(
                    "<Button-1>",
                    lambda evento, f=fila, c=columna:
                    self.descubrir(f, c)
                )

                boton.bind(
                    "<Button-3>",
                    lambda evento, f=fila, c=columna:
                    self.bandera(f, c)
                )

                fila_botones.append(boton)

            self.botones.append(fila_botones)

        self.reiniciar()

    def reiniciar(self):
        self.tablero = [
            [0 for _ in range(COLUMNAS)]
            for _ in range(FILAS)
        ]

        self.descubiertas = set()
        self.banderas = set()

        self.primera_jugada = True
        self.terminado = False
        self.segundos = 0
        self.temporizador_id = None

        self.etiqueta_minas.config(
            text=f"💣 Minas: {MINAS}"
        )
        self.etiqueta_tiempo.config(text="⏱ 0 s")
        self.boton_reiniciar.config(text="😊 Reiniciar")

        for fila in range(FILAS):
            for columna in range(COLUMNAS):
                self.botones[fila][columna].config(
                    text="",
                    bg="#B0BEC5",
                    relief="raised",
                    state="normal"
                )

        self.iniciar_temporizador()

    def iniciar_temporizador(self):
        if not self.terminado:
            self.etiqueta_tiempo.config(
                text=f"⏱ {self.segundos} s"
            )
            self.segundos += 1
            self.temporizador_id = self.ventana.after(
                1000, self.iniciar_temporizador
            )

    def colocar_minas(self, fila_segura, columna_segura):
        posiciones = [
            (f, c)
            for f in range(FILAS)
            for c in range(COLUMNAS)
            if (f, c) != (fila_segura, columna_segura)
        ]

        minas_elegidas = random.sample(posiciones, MINAS)

        for f, c in minas_elegidas:
            self.tablero[f][c] = -1

        for fila in range(FILAS):
            for columna in range(COLUMNAS):
                if self.tablero[fila][columna] == -1:
                    continue

                cantidad = 0

                for f in range(max(0, fila - 1),
                               min(FILAS, fila + 2)):
                    for c in range(max(0, columna - 1),
                                   min(COLUMNAS, columna + 2)):
                        if self.tablero[f][c] == -1:
                            cantidad += 1

                self.tablero[fila][columna] = cantidad

    def descubrir(self, fila, columna):
        if self.terminado:
            return

        if (fila, columna) in self.banderas:
            return

        if (fila, columna) in self.descubiertas:
            return

        if self.primera_jugada:
            self.colocar_minas(fila, columna)
            self.primera_jugada = False

        if self.tablero[fila][columna] == -1:
            self.perder(fila, columna)
            return

        pendientes = [(fila, columna)]

        while pendientes:
            f, c = pendientes.pop()

            if (f, c) in self.descubiertas:
                continue

            if (f, c) in self.banderas:
                continue

            self.descubiertas.add((f, c))

            numero = self.tablero[f][c]
            boton = self.botones[f][c]

            boton.config(
                text=str(numero) if numero > 0 else "",
                bg="#ECEFF1",
                relief="sunken",
                fg=self.colores.get(numero, "black")
            )

            if numero == 0:
                for nf in range(max(0, f - 1),
                                min(FILAS, f + 2)):
                    for nc in range(max(0, c - 1),
                                    min(COLUMNAS, c + 2)):
                        if (nf, nc) not in self.descubiertas:
                            pendientes.append((nf, nc))

        self.comprobar_victoria()

    def bandera(self, fila, columna):
        if self.terminado:
            return

        if (fila, columna) in self.descubiertas:
            return

        posicion = (fila, columna)
        boton = self.botones[fila][columna]

        if posicion in self.banderas:
            self.banderas.remove(posicion)
            boton.config(text="")
        else:
            self.banderas.add(posicion)
            boton.config(text="🚩")

        restantes = MINAS - len(self.banderas)

        self.etiqueta_minas.config(
            text=f"💣 Minas: {restantes}"
        )

    def perder(self, fila, columna):
        self.terminado = True
        self.detener_temporizador()

        self.boton_reiniciar.config(text="😵 Reiniciar")

        for f in range(FILAS):
            for c in range(COLUMNAS):
                if self.tablero[f][c] == -1:
                    self.botones[f][c].config(
                        text="💣",
                        bg="#FFCDD2"
                    )

        self.botones[fila][columna].config(bg="#F44336")

        messagebox.showinfo(
            "Fin del juego",
            "¡BOOM! Pisaste una mina.\nIntentá nuevamente."
        )

    def comprobar_victoria(self):
        casillas_seguras = FILAS * COLUMNAS - MINAS

        if len(self.descubiertas) == casillas_seguras:
            self.terminado = True
            self.detener_temporizador()

            self.boton_reiniciar.config(text="😎 Reiniciar")

            for f in range(FILAS):
                for c in range(COLUMNAS):
                    if self.tablero[f][c] == -1:
                        self.botones[f][c].config(text="🚩")

            self.etiqueta_minas.config(text="💣 Minas: 0")

            messagebox.showinfo(
                "¡Victoria!",
                f"¡Ganaste!\nTiempo: {self.segundos - 1} segundos"
            )

    def detener_temporizador(self):
        if self.temporizador_id is not None:
            self.ventana.after_cancel(self.temporizador_id)
            self.temporizador_id = None


if __name__ == "__main__":
    ventana = tk.Tk()
    juego = Buscaminas(ventana)
    ventana.mainloop()
